      "content_id": "sha256:153c9dbcc7025ecd7e50ce6d83f1995233dfc636bc869098e3a8d84288fd938a"
    },
    {
      "name": "integers",
      "value": {
        "zero": 0,
        "positive": 1234567890,
        "negative": -42
      },
      "canonical": "{\"negative\":-42,\"positive\":1234567890,\"zero\":0}",
